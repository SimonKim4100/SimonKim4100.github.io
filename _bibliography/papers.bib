@article{kim2026hari4d,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  title       = {{HARI4D}: Hand-Articulation Aware {4D} Reconstruction of Human-Object Interaction},
  author      = {Kim, Semin and Xie, Xianghui and Li, Chuqiao and Kim, Jongyoo and Pons-Moll, Gerard},
  journal     = {arXiv preprint arXiv:2611.32932},
  year        = {2026},
  month       = nov,
  arxiv       = {2611.32932},
  pdf         = {https://arxiv.org/pdf/2611.32932},
  abstract    = {Reasoning about human-object interaction from RGB cameras is important for gaming, VR environments, and robot learning. Yet 4D reconstruction from a monocular RGB camera is challenging, especially when articulated hands are involved. Prior full-body works neglect hands during reconstruction, causing them to penetrate into, or float from the object. We present HARI4D, a hand-articulation-aware method for reconstructing spatially and temporally consistent 4D human-object interaction from monocular RGB video. We introduce a history-aware object tracker that provides robust and stable tracking. Based on these tracks, we improve the interaction configuration through coarse-to-fine reasoning that follows the order of object manipulation: ReachNet first brings the full body and arms to the object during contact, and TouchNet then finalizes hand articulation according to temporal context and local object geometry. On ARCTIC, unseen in training, our method reduces the object error by 56\% and improves hand contact F1 from 0.866 to 0.921 over prior art. Our method recovers accurate full body-object interaction with coherent hand articulations and applies to online videos. Our code and pretrained models will be released.}
}

@article{kim2026grasphoi,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  title       = {{GraspHOI}: Full-Body {3D} Human-Object Reconstruction with Articulated Hands from a Single In-the-Wild Image},
  author      = {Kim, Semin and Shin, Haechan and Kim, Jongyoo},
  journal     = {arXiv preprint arXiv:2608.28386},
  year        = {2026},
  month       = aug,
  arxiv       = {2608.28386},
  pdf         = {https://arxiv.org/pdf/2608.28386},
  abstract    = {Existing monocular full-body 3D human-object interaction (HOI) methods do not combine category-agnostic object reconstruction with finger-level contact. Their hands may float off or sink into objects, breaking realism in AR/VR environments. We present GraspHOI, the first category-agnostic framework that reconstructs a full-body 3D HOI from a single image and jointly refines the arms and fingers so that the hands meet the reconstructed object surface. GraspHOI reconstructs the body, hands, and object separately with foundation models and places them in a shared metric camera frame through depth-based registration and silhouette alignment. Occlusion-aware contact correspondences seat the object against the hand, and contact-aware optimization refines shoulder, elbow, wrist, and finger rotations while anchoring the joints to the image. We find that with fingers capped near the image estimate, refining them alone is insufficient; freeing the arm removes most of the remaining hand-object gap, since in a full body the arm chain places the hand. In experiments on three datasets, GraspHOI yields more plausible hand-object contact than four baselines and better relative human-object placement than HDM and TeHOR.}
}
